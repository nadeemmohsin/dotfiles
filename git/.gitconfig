[user]
  name = Nadeem Mohsin
  email = nadeemm@verily.com

  [url "git@github.com:"]
    insteadOf = https://github.com
  [url "ssh://git@github.com/verily-src/"]
    insteadOf = https://github.com/verily-src/
  [url "ssh://git@github.com/"]
    insteadOf = https://github.com/

[push]
  default = current
  autoSetupRemote = true

[alias]
  sw = switch
  co = checkout
  mk = switch -c
  br = branch -l -v
  ci = !git checkout $(git branch -l nm/* | fzf | xargs)
  st = status
  ll = log --pretty --oneline
  # Rebase onto main.
  rbm = !git sw main && git pull && git sw - && git rebase main
  # Prune all local branches other than main.
  pra = git br | grep -v main | xargs git branch -D
  # Prune all the merged branches.
  pmb = "!f() { \
      for b in $(git for-each-ref --format='%(refname:short)' refs/heads/); do \
  	s=$(gh pr view \"$b\" --json state --jq .state 2>/dev/null); \
  	if [ \"$s\" = \"MERGED\" ]; then \
  	    echo \"Deleting merged branch: $b\"; \
  	    git branch -D \"$b\"; \
  	fi; \
      done; \
  }; f"


[core]
  sshCommand="/usr/bin/ssh"

[maintenance]
  auto = false
  strategy = incremental
  repo = /Users/nadeemm/verily1

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
